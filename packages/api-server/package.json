{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./common": {
      "types": "./dist/common/index.d.ts",
      "default": "./dist/common/index.js"
    },
    "./types/*": {
      "types": "./dist/types/*.d.ts",
      "default": "./dist/types/*.js"
    },
    "./types/crud.types": {
      "types": "./dist/types/crud.types.d.ts",
      "default": "./dist/types/crud.types.js"
    },
    "./interfaces/*": {
      "types": "./dist/interfaces/*.d.ts",
      "default": "./dist/interfaces/*.js"
    },
    "./bases/*": {
      "types": "./dist/bases/*.d.ts",
      "default": "./dist/bases/*.js"
    },
    "./utils/*": {
      "types": "./dist/utils/*.d.ts",
      "default": "./dist/utils/*.js"
    },
    "./modules/templates": {
      "types": "./dist/modules/templates/index.d.ts",
      "default": "./dist/modules/templates/index.js"
    },
    "./modules/event-checkouts": {
      "types": "./dist/modules/event-checkouts/index.d.ts",
      "default": "./dist/modules/event-checkouts/index.js"
    },
    "./modules/locations": {
      "types": "./dist/modules/locations/index.d.ts",
      "default": "./dist/modules/locations/index.js"
    },
    "./modules/speakers": {
      "types": "./dist/modules/speakers/index.d.ts",
      "default": "./dist/modules/speakers/index.js"
    },
    "./modules/seo-metas": {
      "types": "./dist/modules/seo-metas/index.d.ts",
      "default": "./dist/modules/seo-metas/index.js"
    },
    "./modules/screens": {
      "types": "./dist/modules/screens/index.d.ts",
      "default": "./dist/modules/screens/index.js"
    },
    "./modules/cameras": {
      "types": "./dist/modules/cameras/index.d.ts",
      "default": "./dist/modules/cameras/index.js"
    },
    "./modules/face-data": {
      "types": "./dist/modules/face-data/index.d.ts",
      "default": "./dist/modules/face-data/index.js"
    },
    "./modules/*": {
      "types": "./dist/modules/*/index.d.ts",
      "default": "./dist/modules/*/index.js"
    },
    "./modules/users/*": {
      "types": "./dist/modules/users/*.d.ts",
      "default": "./dist/modules/users/*.js"
    }
  },
  "scripts": {
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "build": "node -e \"const fs=require('node:fs'); fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@mikro-orm/core": "^6.0.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.0.0",
    "bcryptjs": "^2.4.3",
    "exceljs": "^4.4.0",
    "google-auth-library": "^9.15.1",
    "jszip": "^3.10.1",
    "sharp": "^0.34.5",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.4.0"
  }
}
