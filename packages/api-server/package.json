{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./common": {
      "types": "./dist/common/index.d.ts",
      "default": "./dist/common/index.js"
    },
    "./types/*": {
      "types": "./dist/types/*.d.ts",
      "default": "./dist/types/*.js"
    },
    "./types/crud.types": {
      "types": "./dist/types/crud.types.d.ts",
      "default": "./dist/types/crud.types.js"
    },
    "./bases/*": {
      "types": "./dist/bases/*.d.ts",
      "default": "./dist/bases/*.js"
    },
    "./utils/*": {
      "types": "./dist/utils/*.d.ts",
      "default": "./dist/utils/*.js"
    },
    "./modules/*": {
      "types": "./dist/modules/*/index.d.ts",
      "default": "./dist/modules/*/index.js"
    },
    "./modules/users/*": {
      "types": "./dist/modules/users/*.d.ts",
      "default": "./dist/modules/users/*.js"
    }
  },
  "scripts": {
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "build": "node -e \"const fs=require('node:fs'); fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "sync:template": "node deploy/cli/sync-template.cjs",
    "prune:module-specs": "node deploy/cli/lib/prune/prune-pkg-module-specs.cjs",
    "render": "node deploy/cli/render.cjs",
    "render:matrix": "node deploy/cli/render-matrix.cjs",
    "render:regenerate:checkin": "node deploy/cli/render.cjs apps/hub-event/api --skip-sync-template",
    "verify:template": "node deploy/cli/verify/template.mjs",
    "verify:entity-closure": "node deploy/cli/verify/verify-entity-closure.mjs",
    "verify:checkin-api": "node deploy/cli/verify/checkin-api.mjs",
    "verify:endpoint-parity": "node deploy/cli/verify/endpoint-parity.mjs",
    "test:nest-contract": "jest --config deploy/jest.nest-contract.config.cjs",
    "test:nest-module-specs": "jest --config deploy/jest.nest-module-specs.config.cjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "dependencies": {
    "@mikro-orm/core": "^6.0.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "bcryptjs": "^2.4.3",
    "exceljs": "^4.4.0",
    "google-auth-library": "^9.15.1",
    "jszip": "^3.10.1",
    "sharp": "^0.34.5",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.0.0",
    "@clack/prompts": "^0.10.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.4.0"
  }
}
