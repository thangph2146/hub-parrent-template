{
  "id": "mono-repo-template",
  "role": "upstream",
  "description": "Template upstream — packages/ là thư viện đầy đủ; apps/main = sandbox dev; apps/* khác = reference bootstrap downstream.",
  "defaultRemote": "https://github.com/thangph2146/mono-repo-template.git",
  "defaultRef": "main",
  "remoteName": "template",
  "library": {
    "root": "packages",
    "pullMode": "full",
    "composition": {
      "admin": "@workspace/admin-app",
      "api": "@workspace/api-server"
    },
    "note": "Downstream luôn kéo toàn bộ packages/ — không subset."
  },
  "primaryProductLine": "hub-checkin",
  "inheritPaths": [
    "packages",
    "script-system/admin",
    "script-system/db",
    "script-system/dev",
    "script-system/env",
    "script-system/git",
    "script-system/lib",
    "script-system/README.md",
    "script-system/sync/lib",
    "script-system/sync/downstream-sync-profile.cjs",
    "script-system/sync/post-pull-downstream.cjs",
    "script-system/sync/pull-template.cjs",
    "script-system/sync/sync-checkin-menu-tree.cjs",
    "script-system/sync/sync-checkin-packages.cjs",
    "script-system/sync/sync-parent.cjs",
    "script-system/verify",
    "ecosystem",
    "docs/admin-pattern",
    "docs/api-pattern",
    "docs/api-client-pattern",
    "docs/ui-pattern",
    "docs/env",
    "docs/steps",
    "docs/TEMPLATE_MONOREPO.md"
  ],
  "inheritRootFiles": [
    ".gitignore",
    "turbo.json",
    "AGENTS.md",
    "apps/README.md",
    "packages/README.md"
  ],
  "keepPaths": [
    "apps",
    "pnpm-workspace.yaml",
    "package.json",
    "template.manifest.json",
    ".template-lock.json",
    "ecosystem",
    ".env",
    ".env.local"
  ],
  "productLines": {
    "hub-checkin": {
      "appsPath": "apps/hub-checkin",
      "ecosystem": "ecosystem/checkin.cjs",
      "pm2Start": "pnpm pm2:start:checkin",
      "packages": ["ui", "admin-app", "api-client", "api-server", "query-client", "logger", "site-config", "editor"]
    },
    "hub-parent": {
      "appsPath": "apps/hub-parent",
      "ecosystem": "ecosystem/main.cjs",
      "pm2Start": "pnpm pm2:start",
      "packages": ["ui", "api-client", "api-server", "query-client", "logger", "site-config", "editor", "promo-codes"]
    },
    "store-sync": {
      "appsPath": "apps/store-sync",
      "ecosystem": "ecosystem/store.cjs",
      "pm2Start": "pnpm pm2:start:store",
      "packages": ["ui", "api-client", "api-server", "query-client", "promo-codes"]
    }
  },
  "deprecated": {
    "syncFromMain": "Không dùng pull:checkin / sync-api-from-main trên downstream — dùng pull:template + packages/api-server generate."
  }
}
