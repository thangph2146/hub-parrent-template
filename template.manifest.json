{
  "id": "mono-repo-template",
  "role": "upstream",
  "description": "Feature-template upstream — packages/ + feature profiles + generic generators là nguồn dùng chung; apps/ và deploy scripts thuộc từng downstream product.",
  "defaultRemote": "https://github.com/thangph2146/mono-repo-template.git",
  "defaultRef": "main",
  "remoteName": "template",
  "library": {
    "root": "packages",
    "pullMode": "full",
    "composition": {
      "admin": "@workspace/admin-app",
      "api": "@workspace/api-server"
    },
    "note": "Downstream luôn kéo toàn bộ packages/ — không subset."
  },
  "primaryProductLine": "hub-checkin",
  "inheritPaths": [
    "packages",
    "script-system/lib",
    "script-system/README.md",
    "script-system/sync/downstream-sync-profile.cjs",
    "script-system/sync/post-pull-downstream.cjs",
    "script-system/sync/pull-template.cjs",
    "script-system/sync/push-template.cjs",
    "script-system/sync/push-product.cjs",
    "script-system/verify",
    "docs/admin-pattern",
    "docs/api-pattern",
    "docs/api-client-pattern",
    "docs/ui-pattern",
    "docs/steps",
    "docs/TEMPLATE_MONOREPO.md"
  ],
  "inheritRootFiles": [
    ".gitignore",
    "turbo.json",
    "AGENTS.md",
    "packages/README.md"
  ],
  "keepPaths": [
    "pnpm-workspace.yaml",
    "package.json",
    "template.manifest.json",
    ".template-lock.json",
    ".env",
    ".env.local"
  ],
  "productLines": {
    "hub-checkin": {
      "featureProfile": "hub-checkin",
      "appTargets": {
        "root": "apps/hub-checkin",
        "api": "apps/hub-checkin/api",
        "frontend": "apps/hub-checkin/hub-checkin-frontend"
      },
      "packages": ["ui", "admin-app", "api-client", "api-server", "query-client", "logger", "site-config", "editor"]
    },
    "hub-parent": {
      "featureProfile": "hub-parent",
      "appTargets": {
        "root": "apps/hub-parent",
        "api": "apps/hub-parent/api",
        "frontend": "apps/hub-parent/hub-parent-frontend"
      },
      "packages": ["ui", "api-client", "api-server", "query-client", "logger", "site-config", "editor", "promo-codes"]
    },
    "store-sync": {
      "featureProfile": "store-sync",
      "appTargets": {
        "root": "apps/store-sync",
        "api": "apps/store-sync/api",
        "frontend": "apps/store-sync/store-sync-frontend"
      },
      "packages": ["ui", "api-client", "api-server", "query-client", "promo-codes"]
    }
  }
}
