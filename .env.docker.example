# ENV_TEMPLATE=docker-compose
# ==============================================================================
# Docker Compose — biến gốc repo (copy → .env cạnh docker-compose.yml)
# ==============================================================================
# Doc: docs/env/README.md
# Chạy app local (không Docker): dùng .env.example trong từng app — pnpm env:init
# ==============================================================================

# ------------------------------------------------------------------------------
# MySQL
# ------------------------------------------------------------------------------

MYSQL_ROOT_PASSWORD=storesync
MYSQL_DATABASE=hub_parent
MYSQL_USER=storesync
MYSQL_PASSWORD=storesync
MYSQL_PORT=3306

# ------------------------------------------------------------------------------
# API container — runtime (Nest đọc ALLOWED_ORIGINS)
# ------------------------------------------------------------------------------

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# EXTERNAL_API_URL=https://parentapi.hub.edu.vn
# EXTERNAL_API_TOKEN=your-token
# BACKUP_IMPORT_SECRET=

# ------------------------------------------------------------------------------
# Build-time NEXT_PUBLIC_* (Dockerfile build-arg — đổi phải rebuild image)
# ------------------------------------------------------------------------------

# NEXT_PUBLIC_API_URL=http://localhost:3002/api
# NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_BACKEND_BASE_PATH=/admin
# NEXT_PUBLIC_TRAILING_SLASH=false
