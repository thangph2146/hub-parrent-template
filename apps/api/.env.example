
NODE_ENV="development"

# Example for MySQL
DATABASE_URL="mysql://root@localhost:3306/hub_parent"
# DB_CLIENT=mysql

# Example for PostgreSQL
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hub_parent
# DB_CLIENT=postgresql

# Example for SQL Server
# DATABASE_URL=sqlserver://user:password@localhost:1433/hub_parent
# DB_CLIENT=mssql

# Example for SQLite
# DATABASE_URL=sqlite://./data.sqlite
# DB_CLIENT=sqlite

# Debugging
# Trong development, SQL query log bật mặc định (NODE_ENV=development).
# Đặt DB_DEBUG=false để tắt khi cần console sạch hơn.
# DB_DEBUG=false

# Application
PORT=3002
SERVICE_NAME="HUB API - Kết nối phụ huynh và nhà trường"

# Optional API prefix:
# - API_PREFIX=api  -> routes as /api/*
# - API_PREFIX=     -> routes at root /*
API_PREFIX=api

# Tuỳ chọn: nếu đặt (khác rỗng), mọi request /api/data-maintenance/* phải gửi header X-Backup-Secret trùng giá trị.
# Để trống = không yêu cầu secret (thường dùng local).
# BACKUP_IMPORT_SECRET=

# RBAC: các route có @Permissions yêu cầu header X-User-Id = id user (sau đăng nhập). Login (/users/login) không cần.

# Comma-separated CORS origins (biến đúng: ALLOWED_ORIGINS)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# External academic API (kết quả học tập) used by HUB proxy endpoints:
# - GET /api/hub/students/:studentId/scores/detailed
# - GET /api/hub/students/:studentId/averages/year
# - GET /api/hub/students/:studentId/averages/terms
# - GET /api/hub/students/:studentId/averages/overall
EXTERNAL_API_URL=http://localhost:5000
# EXTERNAL_API_TOKEN=your-token

# JWT Configuration (dùng chuỗi ngẫu nhiên đủ dài; không commit secret thật)
JWT_SECRET=your-jwt-secret-change-me

# Google OAuth Configuration (lấy từ Google Cloud Console → Credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Danh sách email admin tuyệt đối không được phép chỉnh sửa/xóa từ API.
# Cách nhau bằng dấu phẩy. Mặc định: superadmin@hub.edu.vn
PROTECTED_ADMIN_EMAILS=superadmin@hub.edu.vn

# Storage Configuration
STORAGE_DIR="D:/HUB/data"