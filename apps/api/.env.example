# ==============================================================================
# API (@api) — Environment Variables
# ==============================================================================
# Copy:  cp .env.example .env
# File:  apps/api/.env  (hoặc hub-parent-template/.env ở thư mục gốc monorepo)
#
# Thứ tự nạp (mikro-orm CLI + runtime):
#   1. <monorepo-root>/.env
#   2. apps/api/.env  (ghi đè biến trùng tên)
#
# Chạy dev:  pnpm --filter @api dev   (port 3002, prefix /api)
# Migration: pnpm db -- migration:up
# ==============================================================================

# ------------------------------------------------------------------------------
# Bắt buộc
# ------------------------------------------------------------------------------

NODE_ENV=development

# Chuỗi kết nối DB (ưu tiên). Hỗ trợ: mysql, mariadb, postgres, sqlite
DATABASE_URL=mysql://root@localhost:3306/hub_parent

# Cổng HTTP API (mặc định 3002)
PORT=3002

# ------------------------------------------------------------------------------
# Database — thay thế khi KHÔNG dùng DATABASE_URL
# ------------------------------------------------------------------------------

# Loại DB: mysql | mariadb | postgres | postgresql | sqlite
# DB_TYPE=mysql

# DB_HOST=localhost
# DB_PORT=3306
# DB_USERNAME=root
# DB_PASSWORD=
# DB_DATABASE=hub_parent

# --- Ví dụ PostgreSQL ---
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hub_parent
# DB_TYPE=postgres

# --- Ví dụ SQLite (dev nhanh) ---
# DATABASE_URL=sqlite://./data.sqlite
# DB_TYPE=sqlite
# DB_DATABASE=tuyen-sinh.sqlite

# SQL debug: bật khi NODE_ENV=development (MikroORM debug). Không cần DB_DEBUG.

# ------------------------------------------------------------------------------
# CORS — origin trình duyệt được phép gọi API
# ------------------------------------------------------------------------------

# Tên biến đúng trong code: ALLOWED_ORIGINS (KHÔNG phải CORS_ORIGINS)
# Để trống = cho phép mọi origin (*)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ------------------------------------------------------------------------------
# URL công khai & lưu trữ file
# ------------------------------------------------------------------------------

# URL tuyệt đối API (uploads, ảnh) — bắt buộc production khi chạy sau reverse proxy
# Ví dụ: https://hub.example.com  (không cần /api ở cuối)
# API_PUBLIC_URL=https://hub.example.com

# Thư mục lưu file upload (tương đối cwd apps/api hoặc đường dẫn tuyệt đối)
# Mặc định: <apps/api>/data
STORAGE_DIR=./data

# ------------------------------------------------------------------------------
# Auth & OAuth
# ------------------------------------------------------------------------------

# Google Sign-In — chỉ cần Client ID (verify ID token phía server)
# Lấy từ Google Cloud Console → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=

# Email admin protected — khớp NEXT_PUBLIC_PROTECTED_ADMIN_EMAILS trên @backend
PROTECTED_ADMIN_EMAILS=superadmin@hub.edu.vn

# RBAC: route @Permissions yêu cầu header X-User-Id = id user sau đăng nhập.
# Login (/api/admin/auth/login, /api/public/auth/...) không cần header này.

# ------------------------------------------------------------------------------
# API học tập bên ngoài (proxy điểm / bảng điểm phụ huynh)
# ------------------------------------------------------------------------------

# Endpoints: /api/hub/students/:id/scores/*, averages/*
EXTERNAL_API_URL=https://parentapi.hub.edu.vn
# EXTERNAL_API_TOKEN=

# ------------------------------------------------------------------------------
# HTTP body & logging
# ------------------------------------------------------------------------------

# Giới hạn JSON body Express (import/backup lớn). Nginx cần client_max_body_size tương ứng
HTTP_JSON_BODY_LIMIT=1gb

# HTTP_LOG_BODY_MAX_LEN=8000
# HTTP_LOG_ERROR_MAX_LEN=20000
# HTTP_LOG_RESPONSE_MAX_LEN=4000
# HTTP_LOG_SUCCESS_BODY=true

# ------------------------------------------------------------------------------
# Import / export hệ thống (system maintenance)
# ------------------------------------------------------------------------------

# Mật khẩu plaintext fallback khi import user thiếu password (mặc định ImportFallback#2026)
# IMPORT_FALLBACK_PASSWORD_PLAIN=ImportFallback#2026

# Batch size ghi DB khi import (mặc định 500)
# SYSTEM_IMPORT_DB_BATCH_SIZE=500

# ------------------------------------------------------------------------------
# Script CLI (không cần khi chạy server thường)
# ------------------------------------------------------------------------------

# Đường dẫn file export khi chạy seed-full-export
# SEED_EXPORT_PATH=./backup/export.json

# ==============================================================================
# Ví dụ production
# ==============================================================================
#
# NODE_ENV=production
# PORT=3002
# DATABASE_URL=mysql://user:pass@127.0.0.1:3306/hub_parent
# ALLOWED_ORIGINS=https://hub.example.com,https://admin.hub.example.com
# API_PUBLIC_URL=https://hub.example.com
# STORAGE_DIR=/var/www/hub/data
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# PROTECTED_ADMIN_EMAILS=superadmin@hub.edu.vn
# EXTERNAL_API_URL=https://parentapi.hub.edu.vn
# EXTERNAL_API_TOKEN=<token>
#
# Biến KHÔNG dùng trong code hiện tại (đừng copy từ template cũ):
#   CORS_ORIGINS, DB_CLIENT, API_PREFIX, SERVICE_NAME, JWT_SECRET,
#   GOOGLE_CLIENT_SECRET, BACKUP_IMPORT_SECRET
# ==============================================================================
