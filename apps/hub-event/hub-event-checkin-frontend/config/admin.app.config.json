{
  "id": "hub-checkin",
  "basePath": "/admin",
  "title": "HUB Check-in Admin",
  "modules": [
    "staff",
    "rbac",
    "categories",
    "tags",
    "guides",
    "posts",
    "cameras",
    "hanet-avatars",
    "templates",
    "screens",
    "locations",
    "speakers",
    "settings",
    "file-storage",
    "data",
    "contact-requests"
