    "hrefOverrides": {
      "/events": "@root"
    },
    "nativeGroups": [
      {
        "type": "group",
        "label": "Ký túc xá & Check-in",
        "icon": "Building2",
        "replaceLabel": "Ký túc xá & Check-in",
        "children": [
          {
            "href": "check-in-ky-tuc-xa",
            "label": "Check-in ký túc xá",
            "icon": "Home",
            "permission": null
          }
        ]
      }
    ]
  },
  "pageGuardPermissionPrefix": {
    "staff": "USERS",
    "rbac": "ROLES",
    "data": "SETTINGS",
    "categories": "CATEGORIES",
    "tags": "TAGS",
    "posts": "POSTS",
    "cameras": "CAMERAS",
    "hanet-avatars": "EVENTS",
    "templates": "TEMPLATES",
    "screens": "SCREENS",
    "locations": "LOCATIONS",
    "speakers": "SPEAKERS",
    "guides": "PAGE_CONTENTS",
    "file-storage": "UPLOADS",
    "contact-requests": "CONTACT_REQUESTS",
