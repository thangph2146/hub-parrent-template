{
  "id": "store-sync",
  "basePath": "/admin",
  "title": "StoreSync Admin",
  "modules": [
    "staff",
    "rbac",
    "categories",
    "products",
    "orders",
    "promo-codes",
    "guides",
    "seo-metas",
    "settings",
    "file-storage",
    "data"
  ],
  "native": {
    "files": [
      "layout.tsx",
      "admin-runtime-bridge.tsx",
      "page.tsx",
      "login/page.tsx",
      "register/page.tsx",
      "profile/page.tsx"
    ]
  },
  "dashboard": {
    "relativePath": "dashboard/page.tsx",
    "subtitle": "Đây là bảng điều khiển quản trị StoreSync B2B."
  },
  "menu": {
    "alwaysIncludeHrefs": ["/"],
    "excludeHrefs": [
      "/events",
      "/my-students",
      "/parent-students",
      "/contact-requests",
      "/carts",
      "/tu-tuc-xa",
      "/training-levels",
      "/training-systems",
      "/majors",
      "/courses",
      "/academic-years",
      "/departments",
      "/cameras",
      "/templates",
      "/screens",
      "/locations",
      "/speakers",
      "/posts",
      "/tags",
      "/database-schema",
      "/graph"
    ]
  },
  "pageGuardPermissionPrefix": {
    "staff": "USERS",
    "rbac": "ROLES",
    "data": "SETTINGS",
    "categories": "CATEGORIES",
    "products": "PRODUCTS",
    "orders": "ORDERS",
    "promo-codes": "PROMO_CODES",
    "guides": "PAGE_CONTENTS",
    "seo-metas": "SEO_METAS",
    "file-storage": "UPLOADS",
    "dashboard": "DASHBOARD"
  },
  "pageGuardRoleModulesSkip": ["settings"]
}
