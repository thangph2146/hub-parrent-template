# ==============================================================================
# Backend (Admin Panel — @backend) — Environment Variables
# ==============================================================================
# Copy:  cp .env.example .env
# File:  apps/backend/.env
#
# Lưu ý Next.js:
# - Biến NEXT_PUBLIC_* được nhúng lúc BUILD → đổi trên production phải build lại.
# - Chạy dev:  pnpm --filter @backend dev   (port 3001)
# - Production: pnpm --filter @backend build && next start -p 3001
# ==============================================================================

# ------------------------------------------------------------------------------
# Bắt buộc
# ------------------------------------------------------------------------------

# URL microservice @api — PHẢI có suffix /api
# Dev:   http://localhost:3002/api
# Prod:  https://<domain>/api
NEXT_PUBLIC_API_URL=http://localhost:3002/api

# Dev: proxy /api/* qua Next.js → tránh CORS (localhost vs 127.0.0.1). Tắt trên production.
NEXT_PUBLIC_API_PROXY=true

# SSR / rewrite target — URL tuyệt đối tới @api (không qua browser)
INTERNAL_API_URL=http://127.0.0.1:3002/api

# ------------------------------------------------------------------------------
# Runtime (Next.js / PM2 tự set khi cần)
# ------------------------------------------------------------------------------

NODE_ENV=development

# Port admin (mặc định 3001 — khai báo khi deploy PM2/systemd)
# PORT=3001

# ------------------------------------------------------------------------------
# Routing (đọc trong next.config.ts — set TRƯỚC khi pnpm build)
# ------------------------------------------------------------------------------

# Subfolder admin. Để trống = serve tại root (http://localhost:3001/)
# Prod + nginx subfolder: /admin
NEXT_PUBLIC_BACKEND_BASE_PATH=

# true  → mọi route có dấu / cuối (/login/)
# false → không có dấu / cuối (/login)
NEXT_PUBLIC_TRAILING_SLASH=false

# ------------------------------------------------------------------------------
# Bảo vệ tài khoản admin (client-side guard — khớp PROTECTED_ADMIN_EMAILS trên API)
# ------------------------------------------------------------------------------

# Email cách nhau bằng dấu phẩy — không sửa/xóa từ UI; chỉ email này gán super_admin
NEXT_PUBLIC_PROTECTED_ADMIN_EMAILS=superadmin@hub.edu.vn

# ------------------------------------------------------------------------------
# Tùy chọn — Admin bridge (chuyển phiên từ app khác sang admin)
# ------------------------------------------------------------------------------

# Mặc định: http://localhost:3001
# NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# ==============================================================================
# Ví dụ nhanh
# ==============================================================================
#
# Local — admin tại root:
#   NEXT_PUBLIC_API_URL=http://localhost:3002/api
#   NEXT_PUBLIC_BACKEND_BASE_PATH=
#
# Local — admin dưới /admin:
#   NEXT_PUBLIC_API_URL=http://localhost:3002/api
#   NEXT_PUBLIC_BACKEND_BASE_PATH=/admin
#
# Production:
#   NODE_ENV=production
#   PORT=3001
#   NEXT_PUBLIC_API_URL=https://hub.example.com/api
#   NEXT_PUBLIC_BACKEND_BASE_PATH=/admin
#   NEXT_PUBLIC_PROTECTED_ADMIN_EMAILS=superadmin@hub.edu.vn,admin@congty.vn
#
# Backend KHÔNG dùng DATABASE_URL / JWT — cấu hình đó nằm ở apps/api/.env
# ==============================================================================
