# ENV_TEMPLATE=next-checkin
# ENV_STACK=checkin
# ==============================================================================
# Check-in (@hub-checkin/frontend)
# ==============================================================================
# Copy:  cp .env.example .env
# Doc:   docs/env/README.md
# Dev:   pnpm --filter @hub-checkin/frontend dev
# Stack checkin: @hub-checkin/api :3002 + app này :3000 (admin tại /admin)
# Seed demo (DB của @hub-checkin/api): pnpm db:demo:checkin
# ==============================================================================

# ------------------------------------------------------------------------------
# Kết nối API (bắt buộc)
# ------------------------------------------------------------------------------

NEXT_PUBLIC_API_URL=http://localhost:3002/api
NEXT_PUBLIC_API_PROXY=true
INTERNAL_API_URL=http://127.0.0.1:3002/api

# ------------------------------------------------------------------------------
# Runtime
# ------------------------------------------------------------------------------

NODE_ENV=development
# PORT=3000

# ------------------------------------------------------------------------------
# Admin shell (/admin/* trong cùng app)
# ------------------------------------------------------------------------------

NEXT_PUBLIC_ADMIN_URL=http://localhost:3000
NEXT_PUBLIC_BACKEND_BASE_PATH=
NEXT_PUBLIC_TRAILING_SLASH=false
NEXT_PUBLIC_PROTECTED_ADMIN_EMAILS=superadmin@hub.edu.vn

# Không dùng DATABASE_URL / JWT — xem apps/hub-checkin/api/.env
