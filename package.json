{
  "name": "monorepo-template",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev:main": "node script-system/dev-stack.cjs main",
    "predev:main": "pnpm kill:web",
    "dev:main:fresh": "pnpm kill:web && node script-system/dev-stack.cjs main",
    "dev:main:checkin": "node script-system/dev-stack.cjs main-checkin",
    "predev:main:checkin": "pnpm kill:main:checkin && node script-system/ensure-lexical-built.cjs",
    "dev:main:checkin:fresh": "pnpm kill:main:checkin && node script-system/dev-stack.cjs main-checkin",
    "dev:parent": "node script-system/dev-stack.cjs parent",
    "predev:parent": "pnpm kill:parent",
    "dev:parent:fresh": "pnpm kill:parent && node script-system/dev-stack.cjs parent",
    "dev:checkin": "node script-system/dev-stack.cjs checkin",
    "predev:checkin": "pnpm kill:checkin",
    "dev:checkin:fresh": "pnpm kill:checkin && node script-system/dev-stack.cjs checkin",
    "dev:store": "node script-system/dev-stack.cjs store",
    "predev:store": "pnpm kill:store",
    "dev:store:fresh": "pnpm kill:store && node script-system/dev-stack.cjs store",
    "dev": "turbo dev",
    "predev": "pnpm kill",
    "dev:fresh": "pnpm kill && turbo dev",
    "kill:parent": "node script-system/kill-ports.mjs 3000 3001 3002",
    "kill:main:checkin": "node script-system/kill-ports.mjs 3000 3001 3002",
    "kill:checkin": "node script-system/kill-ports.mjs 3000 3001 3002",
    "kill:store": "node script-system/kill-ports.mjs 3000 3001 3002",
    "kill": "node script-system/kill-ports.mjs 3000 3001 3002",
    "kill:web": "node script-system/kill-ports.mjs 3000 3001",
    "kill:api": "node script-system/kill-ports.mjs 3002",
    "pm2:help": "node script-system/pm2-stack.cjs",
    "pm2:start": "node script-system/pm2-stack.cjs start parent",
    "pm2:reload": "node script-system/pm2-stack.cjs reload parent",
    "pm2:restart": "node script-system/pm2-stack.cjs restart parent",
    "pm2:stop": "node script-system/pm2-stack.cjs stop parent",
    "pm2:delete": "node script-system/pm2-stack.cjs delete parent",
    "pm2:start:checkin": "node script-system/pm2-stack.cjs start checkin",
    "pm2:reload:checkin": "node script-system/pm2-stack.cjs reload checkin",
    "pm2:restart:checkin": "node script-system/pm2-stack.cjs restart checkin",
    "pm2:stop:checkin": "node script-system/pm2-stack.cjs stop checkin",
    "pm2:delete:checkin": "node script-system/pm2-stack.cjs delete checkin",
    "pm2:start:store": "node script-system/pm2-stack.cjs start store",
    "pm2:reload:store": "node script-system/pm2-stack.cjs reload store",
    "pm2:restart:store": "node script-system/pm2-stack.cjs restart store",
    "pm2:stop:store": "node script-system/pm2-stack.cjs stop store",
    "pm2:delete:store": "node script-system/pm2-stack.cjs delete store",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "turbo format && pnpm format:docs",
    "format:docs": "prettier --write \"**/*.md\"",
    "verify:bounds": "node script-system/verify-service-boundaries.mjs",
    "verify:sdk-http": "node script-system/verify-no-sdk-http.mjs",
    "verify:permissions": "node script-system/verify-permission-parity.mjs",
    "check": "pnpm verify:bounds && pnpm verify:sdk-http && pnpm verify:permissions && pnpm lint && pnpm typecheck",
    "check:full": "pnpm verify:bounds && pnpm verify:sdk-http && pnpm verify:permissions && pnpm lint && pnpm typecheck && pnpm graphify:ai-summary",
    "test": "pnpm --filter @api test:all",
    "test:watch": "pnpm --filter @api test:watch",
    "test:cov": "pnpm --filter @api test:cov",
    "graphify:update": "node script-system/graphify-update.cjs apps/main/api && node script-system/graphify-update.cjs apps/main/backend && node script-system/graphify-update.cjs apps/hub-parent/hub-parent-frontend && node script-system/graphify-update.cjs apps/hub-event/hub-event-checkin-frontend && node script-system/graphify-update.cjs apps/store-sync/store-sync-frontend",
    "sync:api": "node script-system/sync-api-from-main.cjs all",
    "sync:api:hub-event": "node script-system/sync-api-from-main.cjs hub-event",
    "sync:api:hub-parent": "node script-system/sync-api-from-main.cjs hub-parent",
    "sync:api:store-sync": "node script-system/sync-api-from-main.cjs store-sync",
    "graphify:ai-summary": "node script-system/graphify-ai-summary.mjs",
    "graphify:refresh": "pnpm graphify:update && pnpm graphify:ai-summary",
    "api": "pnpm --filter @api",
    "db": "pnpm --filter @api exec mikro-orm",
    "db:fresh": "pnpm --filter @api run db:fresh",
    "db:migration:fresh": "pnpm --filter @api run db:migration:fresh",
    "db:seed": "pnpm --filter @api run db:seed",
    "db:demo": "pnpm --filter \"@api\" run seed:demo",
    "seed:superadmin": "pnpm --filter \"@api\" run seed:superadmin"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "turbo": "^2.8.17",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=20"
  }
}
