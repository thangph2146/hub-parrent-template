{
  "name": "monorepo-template",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev:main": "node script-system/dev/dev-stack.cjs main",
    "predev:main": "pnpm kill:web && node script-system/dev/clean-next-cache.cjs --stack main",
    "dev:main:checkin": "node script-system/dev/dev-stack.cjs main-checkin",
    "predev:main:checkin": "pnpm kill:main:checkin && node script-system/dev/clean-next-cache.cjs --stack main-checkin && node script-system/dev/ensure-lexical-built.cjs",
    "dev:parent": "node script-system/dev/dev-stack.cjs parent",
    "predev:parent": "pnpm kill:parent && node script-system/dev/clean-next-cache.cjs --stack parent",
    "dev:checkin": "node script-system/dev/dev-stack.cjs checkin",
    "predev:checkin": "pnpm kill:checkin && node script-system/dev/clean-next-cache.cjs --stack checkin && node script-system/dev/ensure-lexical-built.cjs",
    "dev:store": "node script-system/dev/dev-stack.cjs store",
    "predev:store": "pnpm kill:store && node script-system/dev/clean-next-cache.cjs --stack store",
    "dev": "turbo dev",
    "predev": "pnpm kill && node script-system/dev/clean-next-cache.cjs",
    "kill:parent": "node script-system/dev/kill-ports.cjs 3000 3001 3002",
    "kill:main:checkin": "node script-system/dev/kill-dev-workers.cjs",
    "kill:checkin": "node script-system/dev/kill-dev-workers.cjs --mcp",
    "kill:dev": "node script-system/dev/kill-dev-workers.cjs --mcp",
    "kill:mcp": "node script-system/dev/kill-dev-workers.cjs --mcp --ports-only",
    "kill:store": "node script-system/dev/kill-ports.cjs 3000 3001 3002",
    "kill": "node script-system/dev/kill-ports.cjs 3000 3001 3002",
    "kill:web": "node script-system/dev/kill-ports.cjs 3000 3001",
    "kill:api": "node script-system/dev/kill-ports.cjs 3002",
    "clean:next": "node script-system/dev/clean-next-cache.cjs",
    "pm2:help": "node script-system/deploy/pm2-stack.cjs",
    "pm2:start": "node script-system/deploy/pm2-stack.cjs start parent",
    "pm2:reload": "node script-system/deploy/pm2-stack.cjs reload parent",
    "pm2:restart": "node script-system/deploy/pm2-stack.cjs restart parent",
    "pm2:stop": "node script-system/deploy/pm2-stack.cjs stop parent",
    "pm2:delete": "node script-system/deploy/pm2-stack.cjs delete parent",
    "pm2:start:checkin": "node script-system/deploy/pm2-stack.cjs start checkin",
    "pm2:reload:checkin": "node script-system/deploy/pm2-stack.cjs reload checkin",
    "pm2:restart:checkin": "node script-system/deploy/pm2-stack.cjs restart checkin",
    "pm2:stop:checkin": "node script-system/deploy/pm2-stack.cjs stop checkin",
    "pm2:delete:checkin": "node script-system/deploy/pm2-stack.cjs delete checkin",
    "pm2:start:store": "node script-system/deploy/pm2-stack.cjs start store",
    "pm2:reload:store": "node script-system/deploy/pm2-stack.cjs reload store",
    "pm2:restart:store": "node script-system/deploy/pm2-stack.cjs restart store",
    "pm2:stop:store": "node script-system/deploy/pm2-stack.cjs stop store",
    "pm2:delete:store": "node script-system/deploy/pm2-stack.cjs delete store",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "turbo format && pnpm format:docs",
    "format:docs": "prettier --write \"**/*.md\"",
    "env:init": "node script-system/env/init-env.cjs",
    "env:reorganize": "node script-system/env/reorganize-env.cjs all",
    "verify:env": "node script-system/verify/verify-env-examples.mjs",
    "verify:apps": "node script-system/verify/verify-apps-structure.mjs",
    "verify:imports": "node script-system/verify/verify-import-aliases.mjs",
    "verify:bounds": "node script-system/verify/verify-service-boundaries.mjs",
    "verify:sdk-http": "node script-system/verify/verify-no-sdk-http.mjs",
    "verify:permissions": "node script-system/verify/verify-permission-parity.mjs",
    "verify:api-contract": "node script-system/verify/verify-api-client-contract.mjs",
    "test:api-server": "pnpm --filter @workspace/api-server test",
    "check": "pnpm verify:apps && pnpm verify:imports && pnpm verify:env && pnpm verify:bounds && pnpm verify:sdk-http && pnpm verify:permissions && pnpm verify:main-admin && pnpm verify:checkin-api && pnpm verify:api-profile && pnpm lint && pnpm typecheck",
    "check:full": "pnpm verify:apps && pnpm verify:imports && pnpm verify:env && pnpm verify:bounds && pnpm verify:sdk-http && pnpm verify:permissions && pnpm verify:main-admin && pnpm lint && pnpm typecheck && pnpm graphify:ai-summary",
    "test": "pnpm --filter @api test:all",
    "test:watch": "pnpm --filter @api test:watch",
    "test:cov": "pnpm --filter @api test:cov",
    "graphify:update": "node script-system/graphify/graphify-update.cjs apps/main/api && node script-system/graphify/graphify-update.cjs apps/main/backend && node script-system/graphify/graphify-update.cjs apps/hub-parent/api && node script-system/graphify/graphify-update.cjs apps/hub-parent/hub-parent-frontend && node script-system/graphify/graphify-update.cjs apps/hub-event/api && node script-system/graphify/graphify-update.cjs apps/hub-event/hub-event-checkin-frontend && node script-system/graphify/graphify-update.cjs apps/store-sync/api && node script-system/graphify/graphify-update.cjs apps/store-sync/store-sync-frontend",
    "graphify:update:packages": "node script-system/graphify/graphify-update.cjs packages/ui && node script-system/graphify/graphify-update.cjs packages/admin-app && node script-system/graphify/graphify-update.cjs packages/api-client && node script-system/graphify/graphify-update.cjs packages/api-server",
    "sync:api": "node script-system/sync/sync-api-from-main.cjs all",
    "sync:api:hub-event": "node script-system/sync/sync-api-from-main.cjs hub-event",
    "sync:api:hub-parent": "node script-system/sync/sync-api-from-main.cjs hub-parent",
    "sync:api:store-sync": "node script-system/sync/sync-api-from-main.cjs store-sync",
    "admin:migrate": "node script-system/admin/migrate-admin-modules.cjs",
    "admin:generate": "node script-system/admin/generate-admin-routes.cjs",
    "admin:generate:checkin": "node script-system/admin/generate-admin-routes.cjs apps/hub-event/hub-event-checkin-frontend --prune",
    "admin:fix-package": "node script-system/admin/fix-admin-package-imports.cjs && node script-system/admin/fix-package-api-imports.cjs && node script-system/admin/fix-use-client-order.cjs && node script-system/admin/fix-package-post-migrate.cjs",
    "admin:generate:main": "node script-system/admin/generate-admin-routes.cjs apps/main/backend --prune && node script-system/admin/fix-main-backend-cross-imports.cjs && node script-system/verify/verify-main-admin-sync.mjs",
    "admin:fix-main-imports": "node script-system/admin/fix-main-backend-cross-imports.cjs",
    "pull:checkin": "node script-system/sync/sync-checkin.cjs",
    "sync:checkin": "pnpm pull:checkin",
    "verify:api-profile": "node script-system/verify/verify-api-profile.mjs hub-event",
    "verify:checkin-admin": "node script-system/verify/verify-checkin-admin-sync.mjs",
    "api:generate:checkin": "node script-system/api/generate-api-modules.cjs apps/hub-event/api --prune",
    "verify:checkin-api": "node script-system/verify/verify-checkin-api-modules.mjs",
    "verify:main-admin": "node script-system/verify/verify-main-admin-sync.mjs",
    "test:apps": "node script-system/verify/test-app-operations.mjs all",
    "test:apps:quick": "node script-system/verify/test-app-operations.mjs all --quick",
    "test:checkin": "node script-system/verify/test-app-operations.mjs checkin --quick",
    "test:checkin:full": "node script-system/verify/test-app-operations.mjs checkin",
    "test:api:hub-event": "node script-system/verify/verify-api-profile.mjs hub-event",
    "test:api:hub-parent": "node script-system/verify/verify-api-profile.mjs hub-parent",
    "test:api:store-sync": "node script-system/verify/verify-api-profile.mjs store-sync",
    "test:api:all": "node script-system/verify/test-app-operations.mjs api-all",
    "test:main": "node script-system/verify/test-app-operations.mjs main --quick",
    "test:parent": "node script-system/verify/test-app-operations.mjs hub-parent --quick",
    "test:store": "node script-system/verify/test-app-operations.mjs store-sync --quick",
    "graphify:ai-summary": "node script-system/graphify/graphify-ai-summary.mjs",
    "graphify:task-index": "node script-system/graphify/graphify-task-index.mjs",
    "graphify:brief": "node script-system/graphify/graphify-brief.mjs",
    "graphify:refresh": "pnpm graphify:update && pnpm graphify:update:packages && pnpm graphify:ai-summary",
    "api": "pnpm --filter @api",
    "db": "pnpm --filter @api exec mikro-orm",
    "db:fresh": "pnpm --filter @api run db:fresh",
    "db:migration:fresh": "pnpm --filter @api run db:migration:fresh",
    "db:seed": "pnpm --filter @api run db:seed",
    "db:demo": "pnpm --filter \"@api\" run seed:demo",
    "db:demo:checkin": "pnpm --filter \"@hub-event/api\" run seed:demo",
    "seed:superadmin": "pnpm --filter \"@api\" run seed:superadmin"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "turbo": "^2.8.17",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=20"
  }
}
