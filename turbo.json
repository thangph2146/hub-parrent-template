{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "API_URL",
    "API_PREFIX",
    "PORT",
    "CORS_ORIGINS",
    "SERVICE_NAME",
    "NEXT_PUBLIC_API_URL",
    "HUB_DEV_WAIT_API",
    "HUB_DEV_API_PORT",
    "HUB_DEV_SKIP_PORT_KILL",
    "HUB_DEV_USE_WEBPACK",
    "HUB_DEV_RESOURCE_GUARD",
    "HUB_DEV_CPU_LIMIT_PERCENT",
    "HUB_DEV_GPU_LIMIT_PERCENT",
    "HUB_DEV_RESOURCE_INTERVAL_MS",
    "HUB_DEV_RESOURCE_STRIKES",
    "HUB_DEV_RESOURCE_GRACE_MS",
    "HUB_DEV_GPU_GUARD",
    "WAIT_API_SKIP"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
