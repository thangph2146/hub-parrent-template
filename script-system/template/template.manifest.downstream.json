{
  "role": "downstream",
  "description": "Monorepo sản phẩm — kế thừa FULL packages/ + script-system + ecosystem từ mono-repo-template.",
  "defaultRemote": "https://github.com/thangph2146/mono-repo-template.git",
  "defaultRef": "main",
  "remoteName": "template",
  "library": {
    "root": "packages",
    "pullMode": "full"
  },
  "inheritPaths": [
    "packages",
    "script-system",
    "ecosystem",
    "docs/admin-pattern",
    "docs/api-pattern",
    "docs/api-client-pattern",
    "docs/ui-pattern",
    "docs/env",
    "docs/steps",
    "docs/TEMPLATE_MONOREPO.md",
    ".graphify",
    "packages/.graphify"
  ],
  "inheritRootFiles": [
    "turbo.json",
    "AGENTS.md",
    "packages/README.md"
  ],
  "keepPaths": [
    "apps",
    "pnpm-workspace.yaml",
    "package.json",
    "template.manifest.json",
    ".template-lock.json",
    "README.md",
    "ecosystem",
    ".env",
    ".env.local"
  ]
}
