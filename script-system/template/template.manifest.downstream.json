{
  "role": "downstream",
  "description": "Monorepo sản phẩm — tự sở hữu apps/deploy scripts và kế thừa FULL packages/ + feature profiles + generic generators từ mono-repo-template.",
  "defaultRemote": "https://github.com/thangph2146/mono-repo-template.git",
  "defaultRef": "main",
  "remoteName": "template",
  "library": {
    "root": "packages",
    "pullMode": "full"
  },
  "inheritPaths": [
    "packages",
    "script-system/lib",
    "script-system/README.md",
    "script-system/sync/downstream-sync-profile.cjs",
    "script-system/sync/post-pull-downstream.cjs",
    "script-system/sync/pull-template.cjs",
    "script-system/verify",
    "docs/admin-pattern",
    "docs/api-pattern",
    "docs/api-client-pattern",
    "docs/ui-pattern",
    "docs/steps",
    "docs/TEMPLATE_MONOREPO.md"
  ],
  "inheritRootFiles": [
    ".gitignore",
    "AGENTS.md",
    "packages/README.md"
  ],
  "keepPaths": [
    "apps",
    "scripts",
    "pnpm-workspace.yaml",
    "package.json",
    "template.manifest.json",
    ".template-lock.json",
    "README.md",
    ".env",
    ".env.local"
  ]
}
