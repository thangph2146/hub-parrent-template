{
  "name": "hub-parent-monorepo",
  "private": true,
  "description": "Repo product HUB Parent — apps + dev local; packages kéo từ mono-repo-template.",
  "scripts": {
    "pull:template": "node script-system/sync/pull-template.cjs",
    "post-pull:downstream": "node script-system/sync/post-pull-downstream.cjs",
    "sync": "pnpm pull:template && pnpm post-pull:downstream",
    "sync:full": "pnpm sync && pnpm check",
    "verify:template-downstream": "node script-system/verify/verify-downstream-template.cjs",
    "build": "turbo build",
    "build:packages": "pnpm --filter @workspace/api-server run build",
    "build:prod": "pnpm build:packages && turbo build --filter=@hub-parent/api --filter=@frontend",
    "check": "pnpm verify:template-downstream && pnpm verify:downstream-safe && pnpm verify:api-profile && pnpm verify:bounds && pnpm lint && pnpm typecheck",
    "lint": "turbo lint --filter=./packages/*",
    "typecheck": "turbo typecheck --filter=./packages/*",
    "verify:api-profile": "node script-system/verify/verify-api-profile.cjs hub-parent",
    "verify:downstream-safe": "node script-system/verify/verify-downstream-safe-flow.cjs",
    "verify:bounds": "node script-system/verify/verify-service-boundaries.cjs",
    "admin:generate": "node script-system/admin/generate-admin-routes.cjs",
    "api:render": "node packages/api-server/deploy/cli/render.cjs",
    "api:render:hub-parent": "pnpm --filter @workspace/api-server run render -- --line=hub-parent --skip-sync-template --skip-env --skip-typecheck --prune --prune-entities && node script-system/hub-parent/apply-api-overrides.cjs",
    "dev": "pnpm dev:parent",
    "postinstall": "node scripts/setup/ensure-local-env.cjs",
    "predev:parent": "node scripts/dev/kill-ports.cjs 3000 3002 && pnpm build:packages",
    "dev:parent": "node scripts/dev/dev-stack.cjs",
    "pm2": "node scripts/pm2/stack.cjs",
    "pm2:start": "node scripts/pm2/stack.cjs start",
    "pm2:stop": "node scripts/pm2/stack.cjs stop",
    "pm2:reload": "node scripts/pm2/stack.cjs reload",
    "pm2:restart": "node scripts/pm2/stack.cjs restart",
    "pm2:delete": "node scripts/pm2/stack.cjs delete"
  },
  "devDependencies": {
    "@clack/prompts": "^0.11.0",
    "turbo": "^2.9.9"
  },
  "packageManager": "pnpm@9.15.4"
}
