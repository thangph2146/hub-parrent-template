{
  "name": "hub-parent-monorepo",
  "private": true,
  "description": "Repo site chính HUB — full packages/ từ template; apps/hub-parent deploy.",
  "scripts": {
    "pull:template": "node script-system/sync/pull-template.cjs",
    "post-pull:downstream": "node script-system/sync/post-pull-downstream.cjs",
    "sync": "pnpm pull:template && pnpm post-pull:downstream",
    "sync:full": "pnpm sync && pnpm check",
    "verify:template-downstream": "node script-system/verify/verify-downstream-template.cjs",
    "build": "turbo build",
    "build:packages": "pnpm --filter @workspace/api-server run build && node script-system/dev/ensure-lexical-built.cjs",
    "check": "pnpm verify:template-downstream && pnpm verify:apps && pnpm verify:imports && pnpm verify:env && pnpm verify:bounds && pnpm verify:api-profile && pnpm lint && pnpm typecheck",
    "check:downstream-safe": "pnpm verify:downstream-safe && pnpm check",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "verify:apps": "node script-system/verify/verify-apps-structure.cjs",
    "verify:imports": "node script-system/verify/verify-import-aliases.cjs",
    "verify:env": "node script-system/verify/verify-env-examples.cjs",
    "verify:bounds": "node script-system/verify/verify-service-boundaries.cjs",
    "verify:api-profile": "node script-system/verify/verify-api-profile.cjs hub-parent",
    "verify:downstream-safe": "node script-system/verify/verify-downstream-safe-flow.cjs",
    "test:parent": "node script-system/verify/test-app-operations.cjs hub-parent --quick",
    "dev:parent": "node script-system/dev/dev-stack.cjs parent",
    "predev:parent": "node script-system/dev/kill-ports.cjs 3000 3002 && pnpm build:packages",
    "pm2:start": "node ecosystem/pm2-stack.cjs start parent",
    "pm2:reload": "node ecosystem/pm2-stack.cjs reload parent",
    "pm2:stop": "node ecosystem/pm2-stack.cjs stop parent",
    "push": "node script-system/git/commit-and-push.cjs",
    "env:init": "node script-system/env/init-env.cjs parent",
    "db:bootstrap": "node script-system/db/bootstrap-fresh-api.cjs hub-parent",
    "storage:init": "node script-system/db/init-storage-dirs.cjs hub-parent"
  },
  "devDependencies": {
    "@clack/prompts": "^0.11.0",
    "turbo": "^2.9.9"
  },
  "packageManager": "pnpm@9.15.4"
}
