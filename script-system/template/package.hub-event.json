{
  "name": "hub-event-monorepo",
  "private": true,
  "description": "Repo code chính check-in — full packages/ từ template; compose qua admin-app + api-server.",
  "scripts": {
    "pull:template": "node script-system/sync/pull-template.cjs",
    "verify:template-downstream": "node script-system/verify/verify-downstream-template.mjs",
    "build": "turbo build",
    "build:packages": "pnpm --filter @workspace/api-server run build",
    "check": "pnpm verify:template-downstream && pnpm verify:apps && pnpm verify:imports && pnpm verify:env && pnpm verify:bounds && pnpm verify:checkin-admin && pnpm verify:checkin-api && pnpm verify:api-profile && pnpm lint && pnpm typecheck",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "verify:apps": "node script-system/verify/verify-apps-structure.mjs",
    "verify:imports": "node script-system/verify/verify-import-aliases.mjs",
    "verify:env": "node script-system/verify/verify-env-examples.mjs",
    "verify:bounds": "node script-system/verify/verify-service-boundaries.mjs",
    "verify:api-profile": "node script-system/verify/verify-api-profile.mjs hub-event",
    "verify:checkin-admin": "node script-system/verify/verify-checkin-admin-sync.mjs",
    "verify:checkin-api": "pnpm --filter @workspace/api-server run verify:checkin-api",
    "admin:generate:checkin": "node script-system/admin/generate-admin-routes.cjs apps/hub-event/hub-event-checkin-frontend --prune",
    "api:regenerate:checkin": "pnpm --filter @workspace/api-server run render:regenerate:checkin",
    "test:checkin": "node script-system/verify/test-app-operations.mjs checkin --quick",
    "test:checkin:full": "node script-system/verify/test-app-operations.mjs checkin",
    "dev:checkin": "node script-system/dev/dev-stack.cjs checkin",
    "predev:checkin": "pnpm build:packages",
    "pm2:start:checkin": "node script-system/deploy/pm2-stack.cjs start checkin",
    "pm2:reload:checkin": "node script-system/deploy/pm2-stack.cjs reload checkin",
    "push": "node script-system/git/commit-and-push.cjs",
    "env:init": "node script-system/env/env-init.cjs checkin"
  },
  "devDependencies": {
    "turbo": "^2.9.9"
  },
  "packageManager": "pnpm@9.15.4"
}
