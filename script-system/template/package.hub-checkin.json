{
  "name": "hub-checkin-monorepo",
  "private": true,
  "description": "Repo code chính check-in — full packages/ từ template; compose qua admin-app + api-server.",
  "scripts": {
    "pull:template": "node script-system/sync/pull-template.cjs",
    "post-pull:downstream": "node script-system/sync/post-pull-downstream.cjs",
    "sync": "pnpm pull:template && pnpm post-pull:downstream",
    "sync:full": "pnpm sync && pnpm check",
    "pull:checkin": "node script-system/sync/sync-checkin-packages.cjs",
    "sync:checkin": "pnpm pull:checkin",
    "verify:template-downstream": "node script-system/verify/verify-downstream-template.cjs",
    "build": "turbo build",
    "build:packages": "pnpm --filter @workspace/api-server run build",
    "check": "pnpm verify:template-downstream && pnpm verify:apps && pnpm verify:imports && pnpm verify:env && pnpm verify:bounds && pnpm verify:checkin-admin && pnpm verify:checkin-api && pnpm verify:api-profile && pnpm lint && pnpm typecheck",
    "check:downstream-safe": "pnpm verify:downstream-safe && pnpm check",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "verify:apps": "node script-system/verify/verify-apps-structure.cjs",
    "verify:imports": "node script-system/verify/verify-import-aliases.cjs",
    "verify:env": "node script-system/verify/verify-env-examples.cjs",
    "verify:bounds": "node script-system/verify/verify-service-boundaries.cjs",
    "verify:api-profile": "node script-system/verify/verify-api-profile.cjs hub-checkin",
    "verify:checkin-admin": "node script-system/verify/verify-checkin-admin-sync.cjs",
    "verify:checkin-api": "pnpm --filter @workspace/api-server run verify:checkin-api",
    "verify:downstream-safe": "node script-system/verify/verify-downstream-safe-flow.cjs",
    "admin:fix-package": "node script-system/admin/fix-admin-package-imports.cjs && node script-system/admin/fix-package-api-imports.cjs && node script-system/admin/fix-use-client-order.cjs && node script-system/admin/fix-package-post-migrate.cjs",
    "admin:generate:checkin": "node script-system/admin/generate-admin-routes.cjs apps/hub-checkin/hub-checkin-frontend --prune",
    "api:regenerate:checkin": "pnpm --filter @workspace/api-server run render:regenerate:checkin",
    "test:checkin": "node script-system/verify/test-app-operations.cjs checkin --quick",
    "test:checkin:full": "node script-system/verify/test-app-operations.cjs checkin",
    "dev:checkin": "node script-system/dev/dev-stack.cjs checkin",
    "predev:checkin": "node script-system/dev/kill-ports.cjs 3000 3002 && pnpm build:packages",
    "db:bootstrap:checkin": "node script-system/db/bootstrap-fresh-api.cjs hub-checkin",
    "storage:init:checkin": "node script-system/db/init-storage-dirs.cjs hub-checkin",
    "pm2:start:checkin": "node ecosystem/pm2-stack.cjs start checkin",
    "pm2:reload:checkin": "node ecosystem/pm2-stack.cjs reload checkin",
    "pm2:restart:checkin": "node ecosystem/pm2-stack.cjs restart checkin",
    "pm2:stop:checkin": "node ecosystem/pm2-stack.cjs stop checkin",
    "pm2:delete:checkin": "node ecosystem/pm2-stack.cjs delete checkin",
    "push": "node script-system/git/commit-and-push.cjs",
    "env:init": "node script-system/env/init-env.cjs checkin"
  },
  "devDependencies": {
    "tsx": "^4.22.3",
    "turbo": "^2.9.9"
  },
  "packageManager": "pnpm@9.15.4"
}
