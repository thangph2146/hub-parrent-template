{
  "name": "store-sync-monorepo",
  "private": true,
  "description": "Repo HUB Store — full packages/ từ template; apps/store-sync deploy.",
  "scripts": {
    "pull:template": "node script-system/sync/pull-template.cjs",
    "post-pull:downstream": "node script-system/sync/post-pull-downstream.cjs",
    "sync": "pnpm pull:template && pnpm post-pull:downstream",
    "sync:full": "pnpm sync && pnpm check",
    "verify:template-downstream": "node script-system/verify/verify-downstream-template.cjs",
    "build": "turbo build",
    "build:packages": "pnpm --filter @workspace/api-server run build",
    "check": "pnpm verify:template-downstream && pnpm verify:apps && pnpm verify:imports && pnpm verify:env && pnpm verify:bounds && pnpm verify:api-profile && pnpm verify:store-admin && pnpm lint && pnpm typecheck",
    "check:downstream-safe": "pnpm verify:downstream-safe && pnpm check",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "verify:apps": "node script-system/verify/verify-apps-structure.cjs",
    "verify:imports": "node script-system/verify/verify-import-aliases.cjs",
    "verify:env": "node script-system/verify/verify-env-examples.cjs",
    "verify:bounds": "node script-system/verify/verify-service-boundaries.cjs",
    "verify:api-profile": "node script-system/verify/verify-api-profile.cjs store-sync",
    "verify:store-admin": "node script-system/verify/verify-store-admin-sync.cjs",
    "verify:downstream-safe": "node script-system/verify/verify-downstream-safe-flow.cjs",
    "admin:generate:store": "node script-system/admin/generate-admin-routes.cjs apps/store-sync/store-sync-frontend --prune && node script-system/verify/verify-store-admin-sync.cjs",
    "test:store": "node script-system/verify/test-app-operations.cjs store-sync --quick",
    "dev:store": "node script-system/dev/dev-stack.cjs store",
    "predev:store": "node script-system/dev/kill-ports.cjs 3000 3002 && pnpm build:packages",
    "pm2:start:store": "node ecosystem/pm2-stack.cjs start store",
    "pm2:reload:store": "node ecosystem/pm2-stack.cjs reload store",
    "pm2:stop:store": "node ecosystem/pm2-stack.cjs stop store",
    "push": "node script-system/git/commit-and-push.cjs",
    "env:init": "node script-system/env/init-env.cjs store",
    "db:bootstrap": "node script-system/db/bootstrap-fresh-api.cjs store-sync",
    "storage:init": "node script-system/db/init-storage-dirs.cjs store-sync"
  },
  "devDependencies": {
    "@clack/prompts": "^0.11.0",
    "turbo": "^2.9.9"
  },
  "packageManager": "pnpm@9.15.4"
}
